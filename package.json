{
  "name": "daily-log-federation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "subgraphs/*"
  ],
  "scripts": {
    "seed": "node scripts/seed-all.ts",
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "dev:log": "npm run dev 2>&1 | tee logs/dev.log",
    "compose": "sh scripts/compose.sh",
    "rover:install": "rover plugin install router@2 --elv2-license accept && rover plugin install supergraph@2 --elv2-license accept",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
